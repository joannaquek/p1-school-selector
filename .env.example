# Copy this file to `.env.local` and fill in real values there.
# Never put real API keys in `.env.example` — this file is usually committed to git.

# OneMap — access token from your OneMap developer account (server-side only).
ONEMAP_ACCESS_TOKEN=

# Optional — higher rate limits for `npm run data:download`
# https://guide.data.gov.sg/developer-guide/api-overview/how-to-request-an-api-key
DATA_GOV_SG_API_KEY=
